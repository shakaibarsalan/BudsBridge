<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the program itself, uploaded by the
     release workflow before the installer is built. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="budsbridge.exe" product-name="BudsBridge" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
